{
	"name": "pi-extensions",
	"private": true,
	"type": "module",
	"workspaces": [
		"extensions/*"
	],
	"scripts": {
		"clean": "npm run clean --workspaces",
		"build": "node scripts/run-extension-script.mjs build",
		"check": "biome check --write --error-on-warnings . && npm run check:pinned-deps && npm run check:ts-imports && tsgo --noEmit",
		"check:pinned-deps": "node scripts/check-pinned-deps.mjs",
		"check:ts-imports": "node scripts/check-ts-relative-imports.mjs",
		"test": "npm run test --workspaces --if-present",
		"version:extensions": "node scripts/version-extensions.mjs",
		"publish:extensions": "node scripts/publish-extensions.mjs",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/node": "24.12.4",
		"@typescript/native-preview": "7.0.0-dev.20260120.1",
		"husky": "9.1.7",
		"tsx": "4.22.1",
		"typescript": "5.9.3",
		"@earendil-works/pi-ai": "0.86.1",
		"@earendil-works/pi-agent-core": "0.86.1",
		"@earendil-works/pi-coding-agent": "0.86.1",
		"@earendil-works/pi-tui": "0.86.1",
		"vitest": "4.1.9",
		"typebox": "1.3.27"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"version": "0.0.3",
	"overrides": {
		"rimraf": "6.1.2",
		"gaxios": {
			"rimraf": "6.1.2"
		}
	}
}
