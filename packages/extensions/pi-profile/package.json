{
	"name": "@handy_wote/pi-profile",
	"version": "0.0.3",
	"description": "Profile management extension for pi: gateway profiles, discovery, API routing, and model pools",
	"type": "module",
	"keywords": [
		"pi-package",
		"pi",
		"pi-extension",
		"profile",
		"gateway"
	],
	"pi": {
		"extensions": [
			"./dist/index.js"
		]
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "node -e \"import('node:fs/promises').then(fs=>fs.rm('dist',{recursive:true,force:true}))\"",
		"build": "tsgo -p tsconfig.build.json",
		"check": "tsgo --noEmit -p tsconfig.build.json",
		"test": "node scripts/run-vitest.mjs"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {},
	"devDependencies": {
		"@earendil-works/pi-ai": "0.86.1",
		"@types/node": "24.12.4",
		"vitest": "4.1.9"
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"author": "HandyWote",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/HandyWote/pi.git",
		"directory": "packages/extensions/pi-profile"
	}
}
