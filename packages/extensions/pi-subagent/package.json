{
	"name": "@handy_wote/pi-subagent",
	"version": "0.1.0",
	"description": "Persistent foreground and background subagents for pi",
	"type": "module",
	"keywords": ["pi-package", "pi", "pi-extension", "subagent", "agent"],
	"pi": { "extensions": ["./dist/index.js"] },
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
	"files": ["dist", "README.md", "CHANGELOG.md"],
	"scripts": {
		"clean": "node -e \"import('node:fs/promises').then(fs=>fs.rm('dist',{recursive:true,force:true}))\"",
		"build": "tsgo -p tsconfig.build.json",
		"check": "tsgo --noEmit -p tsconfig.build.json",
		"test": "node ../../coding-agent/node_modules/vitest/dist/cli.js --run"
	},
	"publishConfig": { "access": "public" },
	"dependencies": { "typebox": "1.1.38" },
	"peerDependencies": {
		"@handy_wote/pi-agent-core": "*",
		"@handy_wote/pi-coding-agent": "*",
		"@handy_wote/pi-tui": "*"
	},
	"engines": { "node": ">=22.19.0" },
	"author": "HandyWote",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/HandyWote/pi.git",
		"directory": "packages/extensions/pi-subagent"
	}
}
