{
	"name": "@handy_wote/pi-subagent",
	"version": "0.4.8",
	"description": "Persistent foreground and background subagents for pi",
	"type": "module",
	"keywords": [
		"pi-package",
		"pi",
		"pi-extension",
		"subagent",
		"agent"
	],
	"pi": {
		"extensions": [
			"./dist/index.js"
		]
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "node -e \"import('node:fs/promises').then(fs=>fs.rm('dist',{recursive:true,force:true}))\"",
		"build": "tsgo -p tsconfig.build.json",
		"check": "tsgo --noEmit -p tsconfig.build.json",
		"test": "vitest --run"
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "0.86.1",
		"typebox": "1.3.27",
		"vitest": "4.1.9"
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"author": "HandyWote",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/HandyWote/pi.git",
		"directory": "extensions/pi-subagent"
	}
}
